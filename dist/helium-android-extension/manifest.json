{
  "manifest_version": 3,
  "name": "评论筛选助手（安卓）",
  "version": "1.6.6",
  "description": "按关键词、IP属地和日期筛选当前页面已加载的抖音/小红书/快手评论。安卓版本不含主页资料核验。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://www.xiaohongshu.com/*",
    "https://www.kuaishou.com/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "评论筛选助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kuaishou.com/*"
      ],
      "js": [
        "network_capture_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.kuaishou.com/*"
      ],
      "js": [
        "post_utils.js",
        "comment_api.js",
        "kuaishou_content.js",
        "direct_message.js",
        "task_float.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "network_capture_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "post_utils.js",
        "comment_api.js",
        "profile_metadata.js",
        "xhs_content.js",
        "direct_message.js",
        "task_float.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "network_capture_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "post_utils.js",
        "comment_api.js",
        "profile_metadata.js",
        "profile_fetch.js",
        "douyin_content.js",
        "douyin_search.js",
        "direct_message.js",
        "task_float.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
