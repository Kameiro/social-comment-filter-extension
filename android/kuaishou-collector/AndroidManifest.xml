<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.local.commentcollector" android:versionCode="4" android:versionName="0.1.3">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.smile.gifmaker" />
        <provider android:authorities="dev.local.commentcollector.capture" />
    </queries>
    <application android:label="快手评论采集" android:description="@string/description"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:debuggable="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".CaptureProvider" android:authorities="dev.local.commentcollector.capture"
            android:exported="true" android:grantUriPermissions="false" />
    </application>
</manifest>
